// Cloudflare Workers – static assets only (no server code). Built by `npm run build` into dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aaryaai-kids",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "preview_urls": true,
  "workers_dev": true
}
